# .env.example
# Copy this file to .env and fill in your own values:   cp .env.example .env
#
# NEVER COMMIT .env. It is already in .gitignore. Run `npm run check` before
# every commit. Vercel and Railway don't read this file: paste the same values
# into their dashboards yourself.
#
# Leave a line empty (KEY=) if you don't use that feature yet.

# ── Discord (required) ──────────────────────────────────────

# Developer Portal > your app > General Information > Application ID.
# Used by: the register script (your computer).
DISCORD_APP_ID=

# Developer Portal > your app > General Information > Public Key.
# Used by: Vercel (checks that slash commands really come from Discord).
DISCORD_PUBLIC_KEY=

# Developer Portal > your app > Bot > Reset Token. Treat it like a password.
# Used by: Railway worker, the register script, and Vercel (only for level roles).
DISCORD_TOKEN=

# Optional. Your server's ID (right-click the server icon > Copy Server ID;
# turn on Developer Mode in Discord's Advanced settings first).
# With it, commands register to that server instantly, and level roles work.
DISCORD_GUILD_ID=

# ── Claude (optional: AI moderation, /ask, @mentions) ───────

# Claude Console (https://platform.claude.com) > API Keys. Starts with sk-ant-.
# Used by: Railway (moderation, @mentions) and Vercel (/ask).
ANTHROPIC_API_KEY=

# Optional. Which Claude model to use. Leave it commented out for the default.
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── Supabase (optional: /stats, /leaderboard, /link, saving /mod changes) ──

# Supabase > Project Settings > Data API > Project URL (looks like https://abc.supabase.co).
SUPABASE_URL=

# Supabase > Project Settings > API Keys > a secret key (starts with sb_secret_),
# or on older projects the "service_role" key. Server-side only, never in an app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Level-up announcements (optional, needs Supabase) ───────

# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Used by: Vercel.
DISCORD_WEBHOOK_URL=

# A long random string you make up (at least 32 characters). Use the same value
# here, in Vercel, and in the Supabase webhook's x-webhook-secret header.
WEBHOOK_SECRET=

# ── Moderation worker extras (optional, Railway) ────────────

# Channel ID where the bot reports what it did.
MOD_LOG_CHANNEL_ID=

# Role ID that removes access to most channels. Without it, timeouts are used.
QUARANTINE_ROLE_ID=

# Comma-separated IDs the worker never moderates (on top of /mod settings).
MOD_SKIP_CHANNEL_IDS=
MOD_SKIP_USER_IDS=
